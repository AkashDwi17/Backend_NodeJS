<!DOCTYPE html>
<html>
  <head>
    <title>All Books</title>
  </head>
  <body>
    <h1>All Books</h1>
    <a href="/books/new">Add New Book</a>
    <table border="1">
      <tr>
        <th>ID</th>
        <th>Book Name</th>
        <th>Author</th>
        <th>Price</th>
        <th>Action</th>
      </tr>
      <% books.forEach(book => { %>
      <tr>
        <td><%= book.id %></td>
        <td><%= book.b_name %></td>
        <td><%= book.a_name %></td>
        <td><%= book.b_price %></td>
        <td>
          <a href="/books/<%= book.id %>/edit">Edit</a>
          <form
            action="/books/<%= book.id %>?_method=DELETE"
            method="POST"
            style="display: inline"
          >
            <button type="submit">Delete</button>
          </form>
        </td>
      </tr>
      <% }) %>
    </table>
  </body>
</html>
