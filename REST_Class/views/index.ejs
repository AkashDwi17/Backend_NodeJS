<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="/style.css" />
    <title>All Posts</title>
  </head>
  <body>
    <h1>Quora Posts</h1>

    <% for (post of posts){ %>
    <!-- To Print all the posts data -->
    <div class="post">
      <h3 class="user">@<%= post.username %></h3>
      <h4 class="content"><%= post.content %></h4>

      <br />
      <!-- Add anchor tag : use a button type so after clicking here it will directly rendrer to the Post Find On The Basis Of ID url -->
      <a href="http://localhost:8080/posts/<%=post.id%>"> See in Detail</a>

      <!-- Same as here we given a edit anchor tag to redirect the edit page  -->
      <a href="/posts/<%= post.id %>/edit">Edit</a>

      <form method="POST" action="/posts/<%= post.id %>?_method=DELETE">
        <button>Delete Post</button>
      </form>
    </div>
    <%}%>
    <!-- to create new post  -->
    <br /><br />
    <a href="http://localhost:8080/posts/new"> Create New Post</a>
  </body>
</html>
